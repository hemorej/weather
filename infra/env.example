# Names of the variables in /home/forge/weather.jerome-arfouche.ca/.env (values omitted).
PORT=
# Consumed by infra/forge_deploy.sh only:
PNPM_PATH=
VOLUME_NAME=
# Sentry (optional; unset SENTRY_DSN disables it). The server SDK is preloaded by the
# daemon command in infra/supervisord.conf (`node --import ./server/sentry.server.config.mjs`).
SENTRY_DSN=
# Build-time only, for sourcemap upload (without SENTRY_AUTH_TOKEN none are generated):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
